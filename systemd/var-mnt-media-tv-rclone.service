# TEMPORARY — drive-swap window only. Mounts MyCloud (kimshare) tv/ as FUSE so
# Sonarr/Jellyfin keep working while the Yottamaster array is rebuilt.
# NOTE: requires `user_allow_other` uncommented in /etc/fuse.conf (runbook step 1).
[Unit]
Description=rclone mount mycloud:/Public/tv -> .tmp-media/tv (temp)
After=network-online.target
Wants=network-online.target

[Service]
User=skim
Type=simple
ExecStart=/home/skim/.local/bin/rclone mount mycloud:/Public/tv /home/skim/.tmp-media/tv \
    --vfs-cache-mode writes \
    --dir-cache-time 1h \
    --transfers 8 \
    --allow-other \
    --log-level INFO

[Install]
WantedBy=multi-user.target
