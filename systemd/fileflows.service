[Unit]
Description=FileFlows - Media processing automation (VAAPI / AMD 9060 XT)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/skim/jellyfin-configs/fileflows /mnt/media /mnt/media/fileflows-working

[Service]
User=skim
Group=skim
DevicePolicy=cgroup
DeviceAllow=char-226:128 rwm  # renderD128 (AMD 9060 XT VA-API)
DeviceAllow=char-226:1 rwm    # /dev/dri/card1 (control node, harmless)
ExecStartPre=-/usr/bin/podman rm -f fileflows
ExecStart=/usr/bin/podman run --name fileflows \
  --network host \
  --device /dev/dri/renderD128:/dev/dri/renderD128 \
  --device /dev/dri/card1:/dev/dri/card1 \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/fileflows/Data:/app/Data:z \
  -v /home/skim/jellyfin-configs/fileflows/logs:/app/Logs:z \
  -v /home/skim/jellyfin-configs/fileflows/temp:/app/Temp:z \
  -v /mnt/media:/media \
  -v /mnt/media/fileflows-working:/temp \
  localhost/fileflows-amd-vaapi:latest
ExecStop=/usr/bin/podman stop -t 30 fileflows
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=40

[Install]
WantedBy=default.target
