[Unit]
Description=FileFlows - Media processing pipeline
After=network-online.target mergerfs.service
Wants=network-online.target mergerfs.service
RequiresMountsFor=/mnt/jellyfin/config/fileflows /mnt/media

[Service]
ExecStartPre=/usr/bin/podman rm -f fileflows
ExecStart=/usr/bin/podman run --name fileflows --rm \
  --network host \
  --device /dev/dri:/dev/dri \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /mnt/jellyfin/config/fileflows:/app/Config \
  -v /mnt/jellyfin/config/fileflows/logs:/app/Logs \
  -v /mnt/jellyfin/config/fileflows/temp:/app/Temp \
  -v /mnt/media:/media:rw \
  -v /mnt/media/fileflows-working:/temp \
  fileflows-amd-vaapi:latest
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 fileflows

[Install]
WantedBy=default.target