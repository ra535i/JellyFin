[Unit]
Description=FileFlows - Media processing automation (VAAPI / AMD 9060 XT)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/skim/jellyfin-configs/fileflows /home/skim/jellyfin-configs/fileflows/runner-temp /var/mnt/pool1

[Service]
User=skim
Group=skim
# GPU access is granted by Podman's explicit --device flags below.
# NOTE: no PUID/PGID on purpose. Rootless podman maps container uid 0 -> host skim(1000).
# The image's entrypoint runs dotnet as root when PUID is unset, so FileFlows writes to
# /var/mnt/pool1 as host user skim and can overwrite existing media files. Setting PUID=1000
# made the app run as container uid 1000 = unmapped subuid on host -> EACCES on every file.
# User units can start before system-level fstab mounts settle. Wait up to five minutes
# for the RAID mount and working directory instead of crash-looping against an empty path.
ExecStartPre=/usr/bin/bash -c 'for i in {1..150}; do /usr/bin/mountpoint -q /var/mnt/pool1 && /usr/bin/test -d /home/skim/jellyfin-configs/fileflows/runner-temp && exit 0; /usr/bin/sleep 2; done; exit 1'
ExecStartPre=-/usr/bin/podman rm -f fileflows
# Runner scratch on NVMe, not RAID5: plugin startup is metadata-heavy.
ExecStart=/usr/bin/podman run --name fileflows \
  --network host \
  --device /dev/dri/renderD128:/dev/dri/renderD128 \
  --device /dev/dri/card1:/dev/dri/card1 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/fileflows/Data:/app/Data:z \
  -v /home/skim/jellyfin-configs/fileflows/logs:/app/Logs:z \
  -v /home/skim/jellyfin-configs/fileflows/temp:/app/Temp:z \
  -v /var/mnt/pool1:/media \
  -v /home/skim/jellyfin-configs/fileflows/runner-temp:/temp \
  localhost/fileflows-amd-vaapi:latest
ExecStop=/usr/bin/podman stop -t 30 fileflows
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=40

[Install]
WantedBy=default.target
