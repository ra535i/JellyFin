[Unit]
Description=Jellyseerr - Family request UI
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/bin/podman rm -f jellyseerr
ExecStart=/usr/bin/podman run --name jellyseerr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/jellyseerr:/app/config \
  docker.io/fallenbagel/jellyseerr:latest
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target