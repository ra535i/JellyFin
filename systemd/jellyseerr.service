[Unit]
Description=Jellyseerr - Family request UI
After=network-online.target var-mnt-jellyfin.mount
Wants=network-online.target var-mnt-jellyfin.mount
RequiresMountsFor=/var/mnt/jellyfin

[Service]
ExecStartPre=/usr/bin/podman rm -f jellyseerr
ExecStart=/usr/bin/podman run --name jellyseerr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /mnt/jellyfin/config/jellyseerr:/app/config \
  docker.io/fallenbagel/jellyseerr:latest
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target