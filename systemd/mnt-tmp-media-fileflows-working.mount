# TEMPORARY — drive-swap window only. Bind-mounts the NVMe fileflows-working backup.
[Unit]
Description=Bind /run/media/system/internal-2/fileflows-working -> .tmp-media/fileflows-working (temp)
Requires=run-media-system-internal\x2d2.mount
After=run-media-system-internal\x2d2.mount

[Mount]
Type=bind
What=/run/media/system/internal-2/fileflows-working
Where=/home/skim/.tmp-media/fileflows-working
Options=rw,nosuid,nodev,noexec,relatime

[Install]
WantedBy=multi-user.target
