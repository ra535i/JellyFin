[Unit]
Description=Sonarr - TV automation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/skim/jellyfin-configs/sonarr /var/mnt/pool1

[Service]
ExecStartPre=/usr/bin/podman rm -f sonarr
ExecStart=/usr/bin/podman run --name sonarr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/sonarr:/config:z \
  -v /var/mnt/pool1/tv:/tv:rw \
  -v /var/mnt/pool1/downloads:/downloads:rw,z \
  docker.io/linuxserver/sonarr@sha256:a5c1a5fecbef946927ab90ad68df319ac5fe644057e5fc18cd993f01ac07b2b2
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 sonarr

[Install]
WantedBy=multi-user.target