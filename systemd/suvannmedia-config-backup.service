[Unit]
Description=Back up SuvannMedia application state to OneDrive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=skim
Group=skim
WorkingDirectory=/home/skim/JellyFin
# System services cannot exec scripts labeled in the user's home directory
# under the active SELinux policy. Run the repository-owned script through
# the system interpreter as the unprivileged backup user instead.
ExecStart=/usr/bin/bash /home/skim/JellyFin/scripts/suvannmedia-config-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
