[Unit]
Description=qBittorrent - Torrent client (VPN tunneled via Gluetun proxy)
After=gluetun.service
Wants=gluetun.service
RequiresMountsFor=/mnt/jellyfin/config/qbittorrent /mnt/media/downloads/torrents

[Service]
ExecStartPre=/usr/bin/podman rm -f qbittorrent
ExecStart=/usr/bin/podman run --name qbittorrent --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -e WEBUI_PORT=18080 \
  -v /mnt/jellyfin/config/qbittorrent:/config \
  -v /mnt/media/downloads/torrents:/downloads:rw \
  docker.io/linuxserver/qbittorrent:latest
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 qbittorrent

[Install]
WantedBy=multi-user.target