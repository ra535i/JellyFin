[Unit]
Description=Bazarr - Subtitle automation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/skim/jellyfin-configs/bazarr /var/mnt/pool1

[Service]
ExecStartPre=/usr/bin/podman rm -f bazarr
ExecStart=/usr/bin/podman run --name bazarr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/bazarr:/config:z \
  -v /var/mnt/pool1/movies:/movies:rw \
  -v /var/mnt/pool1/tv:/tv:rw \
  docker.io/linuxserver/bazarr:latest
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 bazarr

[Install]
WantedBy=multi-user.target