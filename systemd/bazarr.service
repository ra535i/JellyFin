[Unit]
Description=Bazarr - Subtitle automation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/jellyfin/config/bazarr /mnt/media/movies /mnt/media/tv

[Service]
ExecStartPre=/usr/bin/podman rm -f bazarr
ExecStart=/usr/bin/podman run --name bazarr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /mnt/jellyfin/config/bazarr:/config \
  -v /mnt/media/movies:/movies:rw \
  -v /mnt/media/tv:/tv:rw \
  docker.io/linuxserver/bazarr:latest
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 bazarr

[Install]
WantedBy=multi-user.target