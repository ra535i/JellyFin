[Unit]
Description=Prowlarr - Indexer manager
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/skim/jellyfin-configs/prowlarr

[Service]
ExecStartPre=/usr/bin/podman rm -f prowlarr
ExecStart=/usr/bin/podman run --name prowlarr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/prowlarr:/config \
  docker.io/linuxserver/prowlarr@sha256:c96b56d94d116a9f4de94bc23d3381689492e6c3cfb7435320e8d982e406f99a
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 prowlarr

[Install]
WantedBy=multi-user.target