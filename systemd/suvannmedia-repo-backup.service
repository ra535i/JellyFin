[Unit]
Description=Verify and push committed SuvannMedia repository backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=skim
Group=skim
WorkingDirectory=/home/skim/JellyFin
# See suvannmedia-config-backup.service: invoke through bash so SELinux does
# not reject direct execution of a repository script beneath /home.
ExecStart=/usr/bin/bash /home/skim/JellyFin/scripts/suvannmedia-repo-backup-push.sh
