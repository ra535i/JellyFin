[Unit]
Description=Tdarr - Media transcode automation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/jellyfin/config/tdarr /mnt/media /mnt/media/transcode-working

[Service]
ExecStartPre=/usr/bin/podman rm -f tdarr
ExecStart=/usr/bin/podman run --name tdarr --rm \
  --network host \
  --device /dev/dri:/dev/dri \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -e serverPort=8266 \
  -e webUIPort=8265 \
  -e internalNode=true \
  -e nodeName="BazziteMain" \
  -v /mnt/jellyfin/config/tdarr/server:/app/server \
  -v /mnt/jellyfin/config/tdarr/logs:/app/logs \
  -v /mnt/media:/media \
  -v /mnt/media/transcode-working:/temp \
  docker.io/haveagitgat/tdarr:latest
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 tdarr

[Install]
WantedBy=multi-user.target