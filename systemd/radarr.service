[Unit]
Description=Radarr - Movie automation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/skim/jellyfin-configs/radarr /var/mnt/pool1

[Service]
ExecStartPre=/usr/bin/podman rm -f radarr
ExecStart=/usr/bin/podman run --name radarr --rm \
  --network host \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=America/New_York \
  -v /home/skim/jellyfin-configs/radarr:/config \
  -v /var/mnt/pool1/movies:/movies:rw,z \
  -v /var/mnt/pool1/downloads:/downloads:rw,z \
  docker.io/linuxserver/radarr:latest
Restart=on-failure
RestartSec=10
ExecStop=/usr/bin/podman stop -t 30 radarr

[Install]
WantedBy=multi-user.target